# Copy to .env and fill in. Never commit .env.

# Twilio (required)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Where new-booking notifications go (can also be set as owner_phone via the admin API)
OWNER_PHONE_NUMBER=whatsapp:+27000000000

# OpenAI (optional: without it the bot can still take bookings, other questions are handed off)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Protects /admin/* and /leads. Required to use them.
ADMIN_PASSWORD=change-me-to-something-long

# Public HTTPS URL Twilio calls, e.g. your ngrok URL. Needed if signature checks fail behind a proxy.
PUBLIC_BASE_URL=
# Only set to false for local testing without Twilio.
TWILIO_VALIDATE_SIGNATURE=true

DATABASE_URL=sqlite:///receptionist.db
RUN_SCHEDULER=true
REMINDER_INTERVAL_MINUTES=15
FLASK_DEBUG=false
PORT=5000
LOG_LEVEL=INFO
